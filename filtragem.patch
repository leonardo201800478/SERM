+                self.setStyleSheet("background-color: #ccc; color: black; border: 1px solid #888;")
+            elif self.state == self.STATE_EXCLUDE:
+                self.setStyleSheet("background-color: #ff4d4d; color: white; border: 1px solid #cc0000;")
+            else:  # INCLUDE
+                self.setStyleSheet("background-color: #4caf50; color: white; border: 1px solid #2e7d32;")
+
+        def set_state(self, state):
+            self.state = state
+            self.update_style()
