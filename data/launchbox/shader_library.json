{
  "version": 2,
  "policy": {
    "api": "slang",
    "default_performance": "medium",
    "allow_reflection_as_default": false,
    "allow_embedded_overlay_as_default": false,
    "notes": "Prefer clean CRT presentation. Third-party shader files are never stored in this repository; they are downloaded directly from their upstream GitHub repositories into the local RetroArch shader directory. Reflection, glass, dynamic bezel and heavy multi-layer presets remain optional and are never selected automatically."
  },
  "shaders": [
    {
      "id": "libretro-crt-guest-advanced-ntsc",
      "name": "CRT Guest Advanced NTSC",
      "filename": "{system}.slangp",
      "reference": ":/shaders/shaders_slang/crt/crt-guest-advanced-ntsc.slangp",
      "source": "libretro/slang-shaders",
      "source_url": "https://github.com/libretro/slang-shaders",
      "performance": "medium",
      "reflection": false,
      "embedded_overlay": false,
      "recommended": true,
      "systems": [],
      "notes": "Primary clean CRT baseline. Official Libretro shader chain; the system preset generated by this project remains a Simple Preset."
    },
    {
      "id": "libretro-crt-guest-advanced",
      "name": "CRT Guest Advanced",
      "filename": "{system}.slangp",
      "reference": ":/shaders/shaders_slang/crt/crt-guest-advanced.slangp",
      "source": "libretro/slang-shaders",
      "source_url": "https://github.com/libretro/slang-shaders",
      "performance": "medium",
      "reflection": false,
      "embedded_overlay": false,
      "recommended": true,
      "systems": [],
      "notes": "Clean RGB/CRT baseline when NTSC signal simulation is not desired."
    },
    {
      "id": "third-party-satpixie-crt",
      "name": "CRT SatPixie",
      "filename": "{system}.slangp",
      "reference": ":/shaders/shaders_slang/crt/satpixie-crt.slangp",
      "source": "Conkwer/satpixie-crt-shader",
      "source_url": "https://github.com/Conkwer/satpixie-crt-shader",
      "performance": "light",
      "reflection": false,
      "embedded_overlay": false,
      "recommended": true,
      "systems": [],
      "download": {
        "repository": "https://github.com/Conkwer/satpixie-crt-shader",
        "ref": "main",
        "source_subdir": "RetroArch/shaders/shaders_slang/crt",
        "destination_subdir": "shaders_slang/crt",
        "include": ["*.slang", "*.slangp"]
      },
      "notes": "Third-party lightweight CRT option. Upstream documents a sharp/default RetroArch preset and optional effects that can be disabled. Files are downloaded only to the user's RetroArch installation."
    },
    {
      "id": "third-party-mega-bezel-std-no-reflect",
      "name": "Mega Bezel STD — No Reflect",
      "filename": "{system}.slangp",
      "reference": ":/shaders/shaders_slang/bezel/Mega_Bezel/Presets/MBZ__4__STD-NO-REFLECT.slangp",
      "source": "HyperspaceMadness/Mega_Bezel",
      "source_url": "https://github.com/HyperspaceMadness/Mega_Bezel",
      "performance": "medium",
      "reflection": false,
      "embedded_overlay": true,
      "recommended": false,
      "systems": [],
      "download": {
        "repository": "https://github.com/HyperspaceMadness/Mega_Bezel",
        "ref": "main",
        "source_subdir": "shaders_slang/bezel/Mega_Bezel",
        "destination_subdir": "shaders_slang/bezel/Mega_Bezel",
        "include": ["*.slang", "*.slangp", "*.params"]
      },
      "notes": "Optional third-party presentation. It has bezel/image layers, so it is intentionally not the clean CRT default."
    },
    {
      "id": "third-party-mega-bezel-potato",
      "name": "Mega Bezel POTATO",
      "filename": "{system}.slangp",
      "reference": ":/shaders/shaders_slang/bezel/Mega_Bezel/Presets/MBZ__5__POTATO.slangp",
      "source": "HyperspaceMadness/Mega_Bezel",
      "source_url": "https://github.com/HyperspaceMadness/Mega_Bezel",
      "performance": "light",
      "reflection": false,
      "embedded_overlay": true,
      "recommended": false,
      "systems": [],
      "download": {
        "repository": "https://github.com/HyperspaceMadness/Mega_Bezel",
        "ref": "main",
        "source_subdir": "shaders_slang/bezel/Mega_Bezel",
        "destination_subdir": "shaders_slang/bezel/Mega_Bezel",
        "include": ["*.slang", "*.slangp", "*.params"]
      },
      "notes": "Lower-cost Mega Bezel option, but it still contains bezel/background behavior and remains opt-in."
    },
    {
      "id": "third-party-duimon-advanced-guest",
      "name": "Duimon Advanced Guest",
      "filename": "{system}.slangp",
      "reference": ":/shaders/Mega_Bezel_Packs/Duimon-Mega-Bezel/Presets/Advanced/{system}/{system}-[ADV]-[Guest]-[Bezel].slangp",
      "source": "Duimon/Duimon-Mega-Bezel",
      "source_url": "https://github.com/Duimon/Duimon-Mega-Bezel",
      "performance": "high",
      "reflection": true,
      "embedded_overlay": true,
      "recommended": false,
      "systems": [],
      "download": {
        "repository": "https://github.com/Duimon/Duimon-Mega-Bezel",
        "ref": "main",
        "source_subdir": "",
        "destination_subdir": "Mega_Bezel_Packs/Duimon-Mega-Bezel",
        "include": ["*.slang", "*.slangp", "*.params"]
      },
      "notes": "Third-party system artwork/presentation. It is deliberately opt-in because reflection and layered graphics can substantially increase GPU work."
    }
  ]
}
