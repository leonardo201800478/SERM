# ============================================================
# SERM repository-wide Git ignore
# ============================================================
# Keep this file conservative: source artifacts such as JSON, XML,
# INI and CFG may be valid project inputs and must not be globally ignored.

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/
virtualenvs/
.virtualenvs/
venv-*/
.venv-*/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
*.whl
pip-wheel-metadata/
.installed.cfg
MANIFEST

# ------------------------------------------------------------
# Tests / quality tools / caches
# ------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------
# IDEs / editors
# ------------------------------------------------------------
# Keep only the intentional V2 VS Code project files under version control.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!v2/.vscode/
!v2/.vscode/settings.json
!v2/.vscode/extensions.json
!v2/.vscode/launch.json
!v2/.vscode/tasks.json

.idea/
*.iml
*.iws
*.ipr
.idea_modules/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.un~
Session.vim
.vim/

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.local
config.local.*
secrets.*

# ------------------------------------------------------------
# OS
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# ------------------------------------------------------------
# Generic temporary files
# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.rej

# ------------------------------------------------------------
# Databases and local runtime state
# ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ------------------------------------------------------------
# Large emulator / ROM artifacts — never version these
# ------------------------------------------------------------
*.zip
*.7z
*.rar
*.chd
*.rom
*.bin
*.iso
*.img
*.mds
*.mdf
*.nrg

# Executables / installers generated locally
*.exe
*.msi
*.msix

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log

# ============================================================
# V1 / legacy generated data
# ============================================================
# These paths belong to the historical application and are intentionally
# kept out of Git. Do not use broad extension rules for V2 source files.
data/input/
data/cache/
data/output/
data/reports/
data/txt/
data/xml/
data/database/
scanner_cache/
rom_scanner_cache/
chd_scanner_cache/
reports/
scan_reports/
exports/
profiles/
filter_profiles/
*.filtered.xml
*.report
*.summary
mame_executable.log
mame-set-builder.log

# Legacy package/build artifacts that may exist at repository root
Pipfile.lock
poetry.lock
environment.yml
environment.yaml
conda.recipe/
conda-env.yml

# Generated documentation
site/
apidocs/
docs/_build/
docs/api/
